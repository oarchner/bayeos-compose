# bayeos-compose runtime overrides.
# Uncomment and set values to override the defaults in docker-compose.yml.

# Which published bayeos-api image to run (must exist on Docker Hub).
# BAYEOS_API_IMAGE=oarchner/bayeos-api:latest

# PostgreSQL defaults for the postgresdb service and bayeos-api connection.
# POSTGRES_USER=bayeos
# POSTGRES_PASSWORD=bayeos
# POSTGRES_DB=bayeos

# QuestDB endpoints used by bayeos-api.
# QUEST_DB_URL=postgresql://admin:quest@questdb:8812/qdb?sslmode=disable
# QUEST_ILP_URL=http://questdb:9009
# QUEST_REST_URL=http://questdb:9000

# Web server / API settings.
# WS_API_PORT=5532
# WS_API_KEY=ChangeThisApiKey
# WS_LOG_LEVEL=info
# WS_GIN_MODE=release
